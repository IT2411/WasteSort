root = true

[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.{kt,kts}]
indent_size = 4
ktlint_function_naming_ignore_when_annotated_with = Composable

[*.{swift}]
indent_size = 4

[*.{py}]
indent_size = 4

[*.{json,yaml,yml,md}]
indent_size = 2
